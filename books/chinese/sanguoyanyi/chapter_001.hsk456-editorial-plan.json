      "id": "c04",
      "title": "三人相识",
      "source_start_quote": "玄德回視其人",
      "required_events": [
        "张飞愿意出钱招募乡勇，与刘备一起做大事",
        "关羽前来投军，刘备、关羽、张飞因共同志向相识"
      ]
    },
    {
      "id": "c05",
      "title": "桃园结义",
      "source_start_quote": "飛曰：「吾莊後有一桃園",
      "required_events": [
        "三人在桃园祭告天地，结为兄弟并发誓同心救民",
        "商人赠送马匹、金银和铁，三人打造兵器并聚集乡勇"
      ]
    },
    {
      "id": "c06",
      "title": "英雄初战",
      "source_start_quote": "不數日，人報黃巾賊將程遠志",
      "required_events": [
        "程远志率军来犯，张飞杀邓茂，关羽斩程远志",
        "三人取得第一次胜利"
      ]
    },
    {
      "id": "c07",
      "title": "解青州之围",
      "source_start_quote": "眾賊見程遠志被斬",
      "required_events": [
        "刘备三人前往救援青州",
        "刘备用伏兵之计击败黄巾军，解开青州之围"
      ]
    },
    {
      "id": "c08a",
      "title": "投奔卢植与颍川火攻",
      "source_start_quote": "龔景犒軍畢",
      "required_events": [
        "刘备前往广宗帮助老师卢植",
        "卢植让刘备到颍川联络皇甫嵩、朱雋，二人用火攻击败黄巾军"
      ]
    },
    {
      "id": "c08b",
      "title": "曹操登场",
      "source_start_quote": "忽見一彪軍馬",
      "required_events": [
