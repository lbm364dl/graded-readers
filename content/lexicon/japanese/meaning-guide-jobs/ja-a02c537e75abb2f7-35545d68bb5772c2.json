    "examples": [
      {
        "sentence": "どこで生まれたか分かりません。",
        "gloss": "in; at",
        "sense_id": "ja-a02c537e75abb2f7-1"
      },
      {
        "sentence": "暗い所でニャーニャー泣いていました。",
        "gloss": "in; at",
        "sense_id": "ja-a02c537e75abb2f7-1"
      },
      {
        "sentence": "男の人の手の上で、吾輩の目が回りました。",
