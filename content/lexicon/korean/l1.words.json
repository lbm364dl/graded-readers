      "proposal": {
        "entries": [
          {
            "id": "보다01/동",
            "headword": "보다",
            "kind": "word",
            "definition_en": "to see, look at, or watch; to regard someone or something as a certain kind, or judge them in a certain way"
          },
          {
            "id": "하다01/보",
            "headword": "하다",
            "kind": "word",
            "definition_en": "an auxiliary verb that adds meaning to another verb or adjective: making or allowing an action or bringing about a state; expressing that an action or state is necessary"
          }
        ],
        "references": [
          {
            "entry_id": "보다01/동",
            "url": "https://krdict.korean.go.kr/m/eng/searchResultView?ParaWordNo=61190&nation=eng",
            "paraphrase_en": "NIKL’s Basic Korean Dictionary lists 보다¹ as a main verb. Senses 1–2 cover seeing, looking and watching. Sense 30 covers regarding or evaluating, with both object + -으로 and object + -게 frames, supporting 사람으로 보다 and 낮게 보다."
          },
          {
            "entry_id": "하다01/보",
            "url": "https://krdict.korean.go.kr/eng/dicSearch/SearchView?ParaWordNo=62888&nation=eng",
            "paraphrase_en": "NIKL’s Basic Korean Dictionary identifies 하다² as an auxiliary verb. Sense 1 describes causing an action or bringing about a state in -게 하다, supporting the retained causative function."
          },
          {
            "entry_id": "하다01/보",
            "url": "https://www.korean.go.kr/nkview/nklife/2018_4/28_4.pdf",
            "paraphrase_en": "NIKL’s Standard Korean Dictionary revision record lists necessity as auxiliary 하다 sense 3: in -어야 하다, the preceding action or state is necessary. This supports the obligation use in 해야 했습니다 under the supplied auxiliary identity."
          }
        ]
      },
