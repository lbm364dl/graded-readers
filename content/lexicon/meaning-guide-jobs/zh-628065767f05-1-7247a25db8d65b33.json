    "entry": {
      "id": "zh-628065767f05-1",
      "headword": "曹嵩",
      "kind": "name",
      "reading": "Cáo Sōng",
      "senses": [
        {
          "id": "zh-628065767f05-1-s1",
          "definition": "Cao Song, a person in the passage"
        }
      ]
    },
    "examples": [
      {
        "sentence": "他的父亲曹嵩原先姓夏侯，因成为宦官曹腾的养子，才改姓曹。",
        "gloss": "Cao Song",
        "sense_id": "zh-628065767f05-1-s1"
      },
      {
        "sentence": "曹操的叔父曾因他游荡无度，向曹嵩告状。",
        "gloss": "Cao Song",
        "sense_id": "zh-628065767f05-1-s1"
      },
      {
        "sentence": "曹嵩相信了他，之后不再听叔父责备，曹操也更加随意。",
        "gloss": "Cao Song",
        "sense_id": "zh-628065767f05-1-s1"
      },
      {
        "sentence": "他是沛国谯郡人，父亲曹嵩原本姓夏侯，因是中常侍曹腾的养子，才改姓曹。",
        "gloss": "Cao Song",
        "sense_id": "zh-628065767f05-1-s1"
      },
      {
        "sentence": "叔父见他游荡无度，便告诉曹嵩。",
        "gloss": "Cao Song",
        "sense_id": "zh-628065767f05-1-s1"
      },
      {
        "sentence": "曹嵩责备他后，他装作中风，骗过了父亲。",
        "gloss": "Cao Song",
        "sense_id": "zh-628065767f05-1-s1"
      },
      {
        "sentence": "从此叔父再说他的过错，曹嵩也不再相信，曹操更加任性放荡。",
        "gloss": "Cao Song",
        "sense_id": "zh-628065767f05-1-s1"
      }
    ],
