  "item": {
    "entry": {
      "id": "zh-779b07352932-1",
      "headword": "皇甫嵩",
      "kind": "name",
      "reading": "Huángfǔ Sōng",
      "senses": [
        {
          "id": "zh-779b07352932-1-s1",
          "definition": "Huangfu Song"
        }
      ]
    },
    "examples": [
      {
        "sentence": "卢植、皇甫嵩、朱隽各自带兵，分三路前往作战。",
        "gloss": "Huangfu Song",
        "sense_id": "zh-779b07352932-1-s1"
      },
      {
        "sentence": "到了颍川，刘备听说皇甫嵩、朱隽正在和黄巾军交战。",
        "gloss": "Huangfu Song",
        "sense_id": "zh-779b07352932-1-s1"
      },
      {
        "sentence": "皇甫嵩和朱隽商量后，决定用火攻。",
        "gloss": "Huangfu Song",
        "sense_id": "zh-779b07352932-1-s1"
      },
      {
        "sentence": "他把卢植的话告诉皇甫嵩。",
        "gloss": "Huangfu Song",
        "sense_id": "zh-779b07352932-1-s1"
      },
      {
        "sentence": "皇甫嵩判断张梁、张宝很可能回广宗找张角，便让刘备回去帮助卢植。",
        "gloss": "Huangfu Song",
        "sense_id": "zh-779b07352932-1-s1"
      },
      {
        "sentence": "卢植让刘备带本部人马，再带一千官军到颍川，联络皇甫嵩、朱隽，约好时间一起进攻。",
        "gloss": "Huangfu Song",
        "sense_id": "zh-779b07352932-1-s1"
      },
      {
        "sentence": "皇甫嵩、朱隽商量后，决定火攻，命士兵各带一把草，暗中埋下伏兵。",
        "gloss": "Huangfu Song",
        "sense_id": "zh-779b07352932-1-s1"
      },
      {
        "sentence": "曹操见过皇甫嵩和朱隽，便带兵继续追击张梁、张宝。",
        "gloss": "Huangfu Song",
        "sense_id": "zh-779b07352932-1-s1"
      },
      {
        "sentence": "刘备见到皇甫嵩和朱隽，转达卢植的意思。",
        "gloss": "Huangfu Song",
        "sense_id": "zh-779b07352932-1-s1"
      },
      {
        "sentence": "皇甫嵩说张梁、张宝会去广宗投靠张角，于是让刘备连夜前往。",
        "gloss": "Huangfu Song",
        "sense_id": "zh-779b07352932-1-s1"
      }
    ],
