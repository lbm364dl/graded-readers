    "entry": {
      "id": "zh-5a273e5a8759-1",
      "headword": "灵帝",
      "kind": "name",
      "reading": "Líng Dì",
      "senses": [
        {
          "id": "zh-5a273e5a8759-1-s1",
          "definition": "Emperor Ling"
        }
      ]
    },
    "examples": [
      {
        "sentence": "灵帝即位后，窦武和陈蕃一起辅佐他。",
        "gloss": "Emperor Ling",
        "sense_id": "zh-5a273e5a8759-1-s1"
      },
      {
        "sentence": "朝代分合本是常事，但祸乱大约从桓帝、灵帝时开始。",
        "gloss": "Emperor Ling",
        "sense_id": "zh-5a273e5a8759-1-s1"
      },
      {
        "sentence": "桓帝死后，灵帝即位，大将军窦武、太傅陈蕃一同辅佐他。",
        "gloss": "Emperor Ling",
        "sense_id": "zh-5a273e5a8759-1-s1"
      },
      {
        "sentence": "建宁二年四月十五日，灵帝登上温德殿，刚坐下，殿角忽然刮起狂风。",
        "gloss": "Emperor Ling",
        "sense_id": "zh-5a273e5a8759-1-s1"
      },
      {
        "sentence": "灵帝惊倒，左右急忙救他入宫，百官奔走躲避。",
        "gloss": "Emperor Ling",
        "sense_id": "zh-5a273e5a8759-1-s1"
      },
      {
        "sentence": "灵帝下诏，询问灾异的缘故。",
        "gloss": "Emperor Ling",
        "sense_id": "zh-5a273e5a8759-1-s1"
      },
      {
        "sentence": "灵帝看完奏章叹气，因而起身更衣。",
        "gloss": "Emperor Ling",
        "sense_id": "zh-5a273e5a8759-1-s1"
      },
      {
        "sentence": "灵帝特别信任张让，称他为“阿父”。",
        "gloss": "Emperor Ling",
        "sense_id": "zh-5a273e5a8759-1-s1"
      }
    ],
