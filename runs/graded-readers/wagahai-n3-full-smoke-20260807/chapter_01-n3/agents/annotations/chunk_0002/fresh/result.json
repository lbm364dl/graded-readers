na":"ない","meaning_en":"not"},{"surface":"と","type":"particle","lemma":"と","kana":"と","meaning_en":"quotative marker"},{"surface":"思い","type":"word","lemma":"思う","kana":"おもい","meaning_en":"thinking"},{"surface":"、","type":"punctuation","lemma":"","kana":"","meaning_en":""},{"surface":"ニャー","type":"word","lemma":"ニャー","kana":"にゃー","meaning_en":"meow"},{"surface":"、","type":"punctuation","lemma":"","kana":"","meaning_en":""},{"surface":"ニャー","type":"word","lemma":"ニャー","kana":"にゃー","meaning_en":"meow"},{"surface":"と","type":"particle","lemma":"と","kana":"と","meaning_en":"quoting a sound"},{"surface":"呼ん","type":"word","lemma":"呼ぶ","kana":"よん","meaning_en":"call"},{"surface":"で","type":"particle","lemma":"で","kana":"で","meaning_en":"te-form linker"},{"surface":"み","type":"auxiliary","lemma":"みる","kana":"み","meaning_en":"try doing"},{"surface":"た","type":"auxiliary","lemma":"た","kana":"た","meaning_en":"past"},{"surface":"。","type":"punctuation","lemma":"","kana":"","meaning_en":""},{"surface":"しかし","type":"word","lemma":"しかし","kana":"しかし","meaning_en":"however"},{"surface":"、","type":"punctuation","lemma":"","kana":"","meaning_en":""},{"surface":"誰","type":"word","lemma":"誰","kana":"だれ","meaning_en":"who / anyone"},{"surface":"も","type":"particle","lemma":"も","kana":"も","meaning_en":"with negation, anyone"},{"surface":"来","type":"word","lemma":"来る","kana":"こ","meaning_en":"come"},{"surface":"なかっ","type":"auxiliary","lemma":"ない","kana":"なかっ","meaning_en":"not"},{"surface":"た","type":"auxiliary","lemma":"た","kana":"た","meaning_en":"past"},{"surface":"。","type":"punctuation","lemma":"","kana":"","meaning_en":""}],"grammar_overlays":[{"start":8,"end":14,"surface":"覚えていない","grammar":"Vている with negative ない expresses a continuing or resultant state that is negated.","meaning_en":"not be in the state of remembering"},{"start":17,"end":22,"surface":"気がつくと","grammar":"A clause followed by と marks a temporal or automatic result: when/as soon as the clause occurs.","meaning_en":"when one notices"},{"start":36,"end":40,"surface":"いた兄弟","grammar":"A plain-form clause directly before a noun modifies that noun.","meaning_en":"the siblings who were present"},{"start":56,"end":71,"surface":"目を開けていられないほど明るい","grammar":"ほど marks the degree or extent expressed by the preceding clause, yielding a so...that relation.","meaning_en":"so bright that the eyes cannot be kept open"},{"start":58,"end":66,"surface":"開けていられない","grammar":"Vていられない expresses inability to remain in a state or continue an action.","meaning_en":"cannot keep one's eyes open"},{"start":72,"end":79,"surface":"這い出してみる","grammar":"Vてみる expresses trying or attempting the action.","meaning_en":"try crawling out"},{"start":72,"end":80,"surface":"這い出してみると","grammar":"と after a clause marks the time or automatic result that follows it.","meaning_en":"when/as soon as one tries crawling out"},{"start":99,"end":105,"surface":"投げ捨てられ","grammar":"られる attached to a verb expresses the passive voice.","meaning_en":"be thrown away"},{"start":99,"end":108,"surface":"投げ捨てられていた","grammar":"Passive られる combined with Vている and past た describes a past resultant state caused by an action.","meaning_en":"was in the state of having been thrown away"},{"start":108,"end":112,"surface":"のである","grammar":"の nominalizes the explanation, and である gives it a formal assertive copula.","meaning_en":"formal explanatory assertion"},{"start":121,"end":124,"surface":"出ると","grammar":"A dictionary-form verb followed by と marks a temporal or automatic result: when/once V happens.","meaning_en":"when/once one leaves"},{"start":139,"end":141,"surface":"座り","grammar":"The continuative form links this action to the following clause.","meaning_en":"sitting and then"},{"start":142,"end":150,"surface":"どうすればいいか","grammar":"Vばいい expresses what action is advisable, while か marks the resulting embedded question.","meaning_en":"what one should do"},{"start":144,"end":149,"surface":"すればいい","grammar":"Vばいい expresses advice, necessity, or the appropriate action.","meaning_en":"should do"},{"start":150,"end":154,"surface":"考えたが","grammar":"が after a clause marks contrast or concession.","meaning_en":"although one thought"},{"start":155,"end":163,"surface":"何も思いつかない","grammar":"Nも with a negative predicate means not ... anything.","meaning_en":"cannot think of anything"},{"start":164,"end":167,"surface":"鳴けば","grammar":"The 仮定 form followed by ば marks a conditional clause.","meaning_en":"if one meows"},{"start":170,"end":175,"surface":"迎えに来る","grammar":"A verb stem followed by に来る expresses coming for the purpose of doing that action.","meaning_en":"come to pick someone up"},{"start":175,"end":181,"surface":"かもしれない","grammar":"かもしれない expresses possibility or uncertainty.","meaning_en":"might / may"},{"start":175,"end":184,"surface":"かもしれないと思い","grammar":"と quotes the preceding proposition as the content of 思う; the continuative 思い links it to the next action.","meaning_en":"thinking that it might happen"},{"start":193,"end":198,"surface":"呼んでみた","grammar":"Vてみる expresses trying the action, and た marks it as past.","meaning_en":"tried calling"},{"start":203,"end":210,"surface":"誰も来なかった","grammar":"Nも with a negative predicate means nobody or none.","meaning_en":"nobody came"}]}