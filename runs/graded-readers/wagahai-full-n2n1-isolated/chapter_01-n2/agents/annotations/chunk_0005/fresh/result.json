":"","kana":"","meaning_en":""},{"surface":"寒さ","type":"word","lemma":"寒さ","kana":"さむさ","meaning_en":"coldness"},{"surface":"と","type":"particle","lemma":"と","kana":"と","meaning_en":"and"},{"surface":"空腹","type":"word","lemma":"空腹","kana":"くうふく","meaning_en":"hunger"},{"surface":"に","type":"particle","lemma":"に","kana":"に","meaning_en":"against; toward"},{"surface":"は","type":"particle","lemma":"は","kana":"は","meaning_en":"topic; contrast"},{"surface":"耐え","type":"word","lemma":"耐える","kana":"たえ","meaning_en":"endure (stem)"},{"surface":"られ","type":"auxiliary","lemma":"られる","kana":"られ","meaning_en":"can endure (potential)"},{"surface":"ない","type":"auxiliary","lemma":"ない","kana":"ない","meaning_en":"not"},{"surface":"。","type":"punctuation","lemma":"","kana":"","meaning_en":""}],"grammar_overlays":[{"start":4,"end":8,"surface":"暗くなり","grammar":"The adverbial form of an adjective plus なる expresses a change into that state.","meaning_en":"become dark"},{"start":15,"end":18,"surface":"雨まで","grammar":"Nまで marks an extreme or unexpected item as included.","meaning_en":"even the rain"},{"start":18,"end":23,"surface":"降ってきた","grammar":"The てくる construction presents an action or change as coming about toward the reference point; た marks it as past.","meaning_en":"the rain came to be falling"},{"start":26,"end":28,"surface":"にも","grammar":"にも combines に with emphatic も to mark an involved target or cause as included, often unexpectedly.","meaning_en":"even from hunger"},{"start":28,"end":34,"surface":"追い詰められ","grammar":"The passive auxiliary られる makes the subject the one subjected to the preceding action.","meaning_en":"be driven into a corner"},{"start":39,"end":43,"surface":"できない","grammar":"The potential verb できる followed by negative ない expresses inability.","meaning_en":"cannot"},{"start":48,"end":52,"surface":"明るくて","grammar":"The て-form of an adjective links it to another descriptive predicate.","meaning_en":"being bright and"},{"start":52,"end":57,"surface":"暖かそうな","grammar":"The auxiliary そうだ, in its attributive form, expresses appearance or likelihood before a noun.","meaning_en":"that looks warm"},{"start":57,"end":59,"surface":"方へ","grammar":"へ marks the direction toward which movement proceeds.","meaning_en":"toward that direction"},{"start":66,"end":69,"surface":"思えば","grammar":"The conditional ば attaches to the verb and frames the clause as a condition or retrospective perspective.","meaning_en":"thinking back"},{"start":73,"end":75,"surface":"には","grammar":"に marks the time or setting, while は adds topic or contrastive emphasis.","meaning_en":"at that time, specifically"},{"start":82,"end":87,"surface":"入っていた","grammar":"ている plus past た describes a state already established at a past reference time.","meaning_en":"had entered"},{"start":87,"end":91,"surface":"のである","grammar":"The explanatory nominalizer の followed by formal copula である presents the statement as an explanatory assertion.","meaning_en":"it was the case that"},{"start":105,"end":108,"surface":"として","grammar":"として marks a role, capacity, or status in which something is considered or treated.","meaning_en":"as a person"},{"start":111,"end":117,"surface":"出会ったのが","grammar":"The nominalizer の turns the preceding clause into a noun-like subject, marked by が.","meaning_en":"the one first encountered"},{"start":121,"end":124,"surface":"という","grammar":"と plus 言う introduces a name, label, or description for the following noun.","meaning_en":"called"},{"start":126,"end":129,"surface":"だった","grammar":"The copula だ combined with past auxiliary た forms the past copula.","meaning_en":"was"},{"start":137,"end":141,"surface":"見るなり","grammar":"V-るなり means that the next event occurs immediately upon completion of the verb.","meaning_en":"as soon as she saw"},{"start":147,"end":150,"surface":"つかんで","grammar":"The て-form links the grasping action to the subsequent action.","meaning_en":"grabbing and then"},{"start":150,"end":152,"surface":"外へ","grammar":"へ marks the destination or direction of movement.","meaning_en":"to the outside"},{"start":161,"end":167,"surface":"駄目だと思い","grammar":"The quotative と followed by 思う frames the preceding proposition as a thought or judgment.","meaning_en":"thinking it was hopeless"},{"start":170,"end":173,"surface":"閉じて","grammar":"The て-form links the closing action to the following action.","meaning_en":"closing and then"},{"start":192,"end":198,"surface":"耐えられない","grammar":"Potential られる followed by negative ない expresses inability to endure.","meaning_en":"cannot endure"}]}