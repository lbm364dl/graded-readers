{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "approved": {
      "type": "boolean"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "candidate_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^/"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "supporting_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^/"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "explanation",
          "candidate_paths",
          "supporting_paths"
        ]
      }
    },
    "prose_revision_reason_en": {
      "type": "string"
    }
  },
  "required": [
    "approved",
    "issues",
    "prose_revision_reason_en"
  ]
