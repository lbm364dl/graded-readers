{
  "type": "object",
  "additionalProperties": false,
  "required": ["segments", "grammar_overlays"],
  "properties": {
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface", "type", "lemma", "kana", "meaning_en"],
        "properties": {
          "surface": {"type": "string", "minLength": 1},
          "type": {"type": "string", "enum": ["word", "auxiliary", "particle", "name", "idiom", "punctuation"]},
          "lemma": {"type": "string"},
          "kana": {"type": "string"},
          "meaning_en": {"type": "string"}
        }
      }
    },
    "grammar_overlays": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end", "surface", "grammar", "meaning_en"],
        "properties": {
          "start": {"type": "integer", "minimum": 0},
          "end": {"type": "integer", "minimum": 1},
          "surface": {"type": "string", "minLength": 1},
          "grammar": {"type": "string", "minLength": 1},
          "meaning_en": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
