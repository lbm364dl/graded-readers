{
  "type": "object",
  "additionalProperties": false,
  "required": ["patches", "grammar_overlays"],
  "properties": {
    "patches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start_index", "end_index", "segments"],
        "properties": {
          "start_index": {
            "type": "integer",
            "minimum": 0,
            "description": "Inclusive CURRENT SEGMENT TOKEN_INDEX, not a character offset."
          },
          "end_index": {
            "type": "integer",
            "minimum": 1,
            "description": "Exclusive CURRENT SEGMENT TOKEN_INDEX, not a character offset."
          },
          "segments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "type", "pinyin", "meaning_en"],
              "properties": {
                "text": {"type": "string", "minLength": 1},
                "type": {"type": "string", "enum": ["word", "particle", "name", "idiom", "punctuation"]},
                "pinyin": {"type": "string"},
                "meaning_en": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "grammar_overlays": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end", "text", "grammar_candidate_key", "pattern", "meaning_en"],
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 0,
            "description": "Inclusive Python character offset into CHUNK; unlike patch token indices."
          },
          "end": {
            "type": "integer",
            "minimum": 1,
            "description": "Exclusive Python character offset into CHUNK; unlike patch token indices."
          },
          "text": {"type": "string", "minLength": 1},
          "grammar_candidate_key": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
          "pattern": {"type": "string", "minLength": 1},
          "meaning_en": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
