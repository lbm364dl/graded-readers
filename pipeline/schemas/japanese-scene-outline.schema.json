{
  "type": "object",
  "additionalProperties": false,
  "required": ["chapter_title", "scenes", "length_reason_en"],
  "properties": {
    "chapter_title": {"type": "string"},
    "length_reason_en": {"type": "string", "minLength": 1},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "source_start_quote", "required_events"],
        "properties": {
          "id": {"type": "string", "pattern": "^scene_[0-9]{2}$"},
          "title": {"type": "string"},
          "source_start_quote": {"type": "string", "minLength": 4},
          "required_events": {"type": "array", "items": {"type": "string"}},
          "target_chars": {"type": "integer", "minimum": 0, "maximum": 2500}
        }
      }
    }
  }
}
